# Local prototype only. Copy to .env and supply local credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_local_mysql_user
DB_PASSWORD=
DB_NAME=stars_companion_db
PORT=5001
NODE_ENV=development
DEMO_PLANNING_ENABLED=true
DEMO_CHAT_ENABLED=true
# Needed only for real model calls. Never expose this in frontend variables.
OPENAI_API_KEY=
OPENAI_AGENTS_DISABLE_TRACING=1
# Optional allowlisted Telegram demo; leave empty unless running the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEMO_USER_ID=
